{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "env": ["VITE_*"],
            "outputs": ["dist/**", ".output/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": [
                "NODE_ENV",
                "HOST",
                "PORT",
                "LOG_*",
                "APP_VERSION",
                "CORS_ORIGINS",
                "DATABASE_PATH",
                "WORKER_*",
                "BACKEND_URL",
                "JOB_*",
                "MAX_*",
                "QUEUE_*",
                "API_INTERNAL_URL",
                "VITE_*"
            ]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "test": {
            "dependsOn": ["^build"],
            "passThroughEnv": ["CI"]
        },
        "start": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true,
            "passThroughEnv": [
                "NODE_ENV",
                "HOST",
                "PORT",
                "LOG_*",
                "APP_VERSION",
                "CORS_ORIGINS",
                "DATABASE_PATH",
                "WORKER_*",
                "BACKEND_URL",
                "JOB_*",
                "MAX_*",
                "QUEUE_*",
                "API_INTERNAL_URL",
                "VITE_*"
            ]
        }
    }
}
