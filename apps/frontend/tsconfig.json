{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "allowJs": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["vite/client", "node"],
        "paths": {
            "@components/*": ["./src/components/*"],
            "@config/*": ["./src/config/*"],
            "@lib/*": ["./src/lib/*"],
            "@styles/*": ["./src/styles/*"]
        }
    },
    "include": ["src", "tests", "vite", "vite.config.ts", "vitest.config.ts"]
}
