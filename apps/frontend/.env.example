# The API the browser and the server rendering call; baked into the bundle at build time.
VITE_API_URL=http://127.0.0.1:4100
# The public origin of this site.
VITE_SITE_URL=http://localhost:3100
# Let search engines index the pages. Only the production build sets it.
VITE_ALLOW_INDEXING=false
# Server only, read at request time: the same value as INTERNAL_API_TOKEN in apps/backend/.env. The API then limits this
# server's rendering per visitor it renders for, not as one caller. For local use only: production refuses it.
INTERNAL_API_TOKEN=local-development-only-render-token-not-a-secret
# Server only: an internal address of the API for the server rendering (falls back to VITE_API_URL).
# API_INTERNAL_URL=http://backend:4100
# Server only, behind a proxy that overwrites it: the single-address header with the visitor's address, passed on to the
# API. Unset, the address of the connection is used. A header proxies append to (x-forwarded-for, forwarded) is refused.
# CLIENT_IP_HEADER=cf-connecting-ip
