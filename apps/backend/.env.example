# Copy to .env for local development (`pnpm env:init`). Every setting is documented in src/config/env.ts.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
DATABASE_PATH=./data/pkg-guard.db
# The worker proves itself with this; the same value is in apps/worker/.env. This one is for local use only: production refuses it.
WORKER_TOKEN=local-development-only-not-a-secret
