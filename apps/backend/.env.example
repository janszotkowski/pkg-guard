# Copy to .env for local development (`pnpm env:init`). Every setting is documented in src/config/env.ts.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
DATABASE_PATH=./data/weighme.db
# The worker proves itself with this; the same value is in docker-compose.yml. This one is for local use only: production refuses it.
WORKER_TOKEN=local-development-only-not-a-secret
# The frontend's server proves itself with this (same value in apps/frontend/.env): its rendering is then limited per
# visitor it names, not as one caller. For local use only: production refuses it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=local-development-only-render-token-not-a-secret
# Requests per caller per minute: to /v1/* (default 300), by the frontend's rendering per visitor (default 600), and
# queueing a package's versions with POST /v1/history (default 10).
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_RENDER_PER_MINUTE=600
# RATE_LIMIT_QUEUE_PER_MINUTE=10
# The MCP server at /v1/mcp: off with false, and requests per minute per caller (default 60) and for all callers together (default 1200).
# MCP_ENABLED=true
# RATE_LIMIT_MCP_PER_MINUTE=60
# RATE_LIMIT_MCP_TOTAL_PER_MINUTE=1200
# Behind a proxy: the header that carries the caller's address, so the limit counts callers, not the proxy.
# Only a single-address header the proxy overwrites (cf-connecting-ip, x-real-ip); x-forwarded-for is refused.
# CLIENT_IP_HEADER=cf-connecting-ip
# Optional, for the stars in the trends table: GitHub allows 60 questions an hour without it. A token with no permissions is enough.
# GITHUB_TOKEN=
