# Copy to .env for local development (`pnpm env:init`). Every setting is documented in src/config/env.ts.
LOG_LEVEL=info
BACKEND_URL=http://127.0.0.1:4100
# The same value as in apps/backend/.env. For local use only: production refuses it.
WORKER_TOKEN=local-development-only-not-a-secret
# Where packages are installed. Empty means a folder in the system's temp directory, outside this repository.
# WORKER_DIR=
WORKER_CONCURRENCY=2
