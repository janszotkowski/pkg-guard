{
    "name": "@weighme/worker",
    "version": "0.0.0",
    "private": true,
    "description": "Worker, run only in Docker: installs one npm package at a time without running its code, bundles it and reports what it costs",
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@weighme/core": "workspace:*",
        "pino": "10.4.0",
        "rolldown": "1.2.14",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "26.6.4",
        "tsdown": "0.23.0",
        "vitest": "5.0.3"
    }
}
